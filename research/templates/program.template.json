{
  "schema_version": 1,
  "program_id": "replace-with-project-id",
  "title": "Replace with research program title",
  "canonical_source": {
    "path": "/absolute/path/to/canonical/source",
    "derived_tree": "/absolute/path/to/derived/artifacts",
    "subject_invariant": "replace-with-project-specific-invariant",
    "detector_disagreement": "replace-with-project-specific-disagreement-policy"
  },
  "content_policy": {
    "model_execution": "local_first",
    "autonomous_external_image_model_allowed": false,
    "reason": "Replace with corpus and policy rationale.",
    "external_model_requirement": "Replace with explicit external-model review rule."
  },
  "artifact_policy": {
    "approved_output_roots": [
      "/absolute/path/to/research-artifacts"
    ],
    "canonical_source_write_allowed": false
  },
  "representation": {
    "expanded_dossier_target_tokens": 100000,
    "expanded_dossier_min_tokens": 100000,
    "compact_context_target_tokens": 4000,
    "compact_context_min_tokens": 4000,
    "legacy_text_encoder_max_tokens": 512,
    "compact_artifacts": {
      "structured": "compact-context.json",
      "human_readable": "compact-context.md",
      "provenance": "compression.json"
    }
  },
  "specialists": {
    "policy": "open_world",
    "required_declaration_fields": [
      "scope",
      "inputs",
      "output_semantics",
      "provenance",
      "abstention_policy",
      "known_failure_modes",
      "qualification_gate"
    ]
  },
  "research_tree": {
    "require_program_root": true,
    "require_parent_issue": true,
    "require_selection_rationale": true
  },
  "gpu_scheduler": {
    "command": "/absolute/path/to/gpu_scheduler.py",
    "execution_mode": "observer_only",
    "max_job_duration_hours": 24,
    "scheduler_project": "replace-with-scheduler-project",
    "allowed_launchers": ["registered-research-launcher"],
    "resources": {
      "gpu-a": {
        "host_route": "local",
        "total_vram_gb": 48,
        "usable_vram_gb": 48
      },
      "gpu-b": {
        "host_route": "ssh:replace-host",
        "total_vram_gb": 80,
        "usable_vram_gb": 72,
        "evergreen_reserved_vram_gb": 8
      }
    }
  },
  "autonomy": {
    "mode": "draft_pr_only",
    "autonomous_merge_allowed": false,
    "autonomous_direct_main_push_allowed": false,
    "autonomous_gpu_execution_allowed": false,
    "autonomous_model_installation_allowed": false,
    "autonomous_canonical_source_write_allowed": false,
    "authorized_without_new_human_approval": [
      "documentation",
      "tests",
      "branches",
      "commits",
      "draft pull requests"
    ],
    "requires_hold": [
      "GPU activity",
      "dataset mutation",
      "model installation",
      "external image-model use",
      "metric or policy uncertainty",
      "merge or direct push to main"
    ]
  }
}
